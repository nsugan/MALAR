# ===== MALAR environment (copy to .env, then edit) =====
# After ANY change here run:  docker compose up -d --force-recreate litellm malar
# (a plain `restart` does NOT reload .env).

# ---- Core services ----
NEO4J_PASSWORD=malar_dev_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
QDRANT_URL=http://qdrant:6333

# ---- LLM gateway (LiteLLM) — agents ONLY ever talk to this ----
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-malar-local
LITELLM_MASTER_KEY=sk-malar-local
LITELLM_SALT_KEY=malar_salt_change_me

# ---- Which ALIAS each agent role uses (the routing layer) ----
# Default = local Ollama. To make a role use a cloud model, point it at that alias, e.g.
#   LLM_REASONER_ALIAS=malar-glm
# Aliases available: malar-reasoner/fast/vision (local), malar-claude, malar-openai,
# malar-deepseek, malar-glm, malar-kimi, malar-nemotron, malar-cosmos, malar-custom,
# malar-frontier.
LLM_REASONER_ALIAS=malar-reasoner
LLM_FAST_ALIAS=malar-fast
LLM_VISION_ALIAS=malar-vision
LLM_TIMEOUT=120

# ========== LOCAL MODELS (Ollama) ==========
# Set the EXACT tag you pulled with `ollama pull`. Keep the `ollama/` prefix.
# To run a different/newer Gemma, change these (e.g. ollama/gemma3:4b). NOTE: there is no
# `gemma4` tag yet — current Google open models are gemma3 / gemma3n; the moment a gemma4
# tag exists you pull it and set it here, no code change needed.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REASONER_MODEL=ollama/gemma4:e4b
OLLAMA_FAST_MODEL=ollama/gemma4:e2b
OLLAMA_VISION_MODEL=ollama/gemma4:e4b

# ========== CLOUD PROVIDERS (OPT-IN; data leaves the box) ==========
# Fill the API key to enable, then set the matching LLM_*_ALIAS above to use it.

# -- Anthropic Claude --
CLAUDE_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=

# -- OpenAI --
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# -- DeepSeek --
DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# -- Zhipu GLM (OpenAI-compatible). Base: api.z.ai (intl) or open.bigmodel.cn (CN). --
GLM_MODEL=openai/glm-4.6
GLM_API_BASE=https://api.z.ai/api/paas/v4
GLM_API_KEY=

# -- Moonshot Kimi (OpenAI-compatible). Base: api.moonshot.ai (intl) or .cn. --
KIMI_MODEL=openai/kimi-k2-0711-preview
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_API_KEY=

# -- NVIDIA Nemotron (NIM, OpenAI-compatible; key from build.nvidia.com). --
NEMOTRON_MODEL=openai/nvidia/nemotron-3-super-120b-a12b
NEMOTRON_API_BASE=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=

# -- NVIDIA Cosmos (NIM; confirm the exact model id on build.nvidia.com for your account). --
COSMOS_MODEL=openai/nvidia/cosmos-reason1-7b
COSMOS_API_BASE=https://integrate.api.nvidia.com/v1
COSMOS_API_KEY=

# -- Generic escape hatch: ANY OpenAI-compatible endpoint --
CUSTOM_MODEL=openai/your-model-name
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# -- "frontier" alias (defaults to Claude; repoint if you like) --
FRONTIER_MODEL=anthropic/claude-sonnet-4-6
FRONTIER_API_KEY=

# ---- MALAR runtime ----
MALAR_DATA_DIR=/app/data
MALAR_REVIEW_MODE=true

# ---- agent-factory role routing (any alias works; also settable in the LLM tab) ----
LLM_CODER_ALIAS=malar-claude
LLM_ALGO_ALIAS=malar-deepseek
